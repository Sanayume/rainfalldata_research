# Unignore the Ensemble_v2 directory itself so its contents can be evaluated
!src/yangtze/Ensemble_v2/

# Then ignore all contents within Ensemble_v2
src/yangtze/Ensemble_v2/*

# Except for Python scripts within Ensemble_v2
!src/yangtze/Ensemble_v2/*.py

# Ignore all contents of results directory by default
results/

# Except for specific files we want to track within results
!results/yangtze/features/kfold_optimization_v6/Train_L0_Probs_v6_Opt.npy
!results/yangtze/features/features/README.md

# Ignore data and models directories
data/
models/
src/ensemble_learning/ensemble_learning/models/

# Ignore Python cache directories and files
__pycache__/
*.pyc

# Ignore specific files
.claude/settings.local.json
src/yangtze/YangTsu/README.md
commit_message.tmp
src/yangtze/Ensemble_v2/03_train_level2_ensemble.py
src/yangtze/Ensemble_v2/quick_bayesian_demo.py
src/yangtze/Ensemble_v2/simplified_bayesian_expert.py
src/yangtze/Ensemble_v2/test_path_fix.py
src/yangtze/Ensemble_v2/train_all_experts_cv.py
src/yangtze/Ensemble_v2/train_fn_in_mac.py